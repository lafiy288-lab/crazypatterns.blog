# Database. SQLite for local dev; for production use Postgres (Supabase/Neon):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
DATABASE_URL="file:./dev.db"

# Public site URL (used for sitemap, Open Graph, canonical URLs)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin account (created/hashed automatically on first login or seed)
ADMIN_EMAIL="admin@patternnest.local"
ADMIN_PASSWORD="ChangeMe-Admin-2026!"

# Long random string used to sign the admin session JWT (openssl rand -base64 48)
AUTH_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# Image storage: "local" (default) | "cloudinary" | "supabase"
STORAGE_DRIVER="local"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="patternnest"

# EUR conversion rate used by the currency selector (1 USD = X EUR)
NEXT_PUBLIC_EUR_RATE="0.92"

# Production: folder outside the app for uploaded images and import files,
# e.g. DATA_DIR="/home/USERNAME/patternnest-data" and
# DATABASE_URL="file:/home/USERNAME/patternnest-data/patternnest.db"
DATA_DIR=""
